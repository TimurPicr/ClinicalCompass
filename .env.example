# Local demo only. Generate distinct values with: python -c 'import secrets; print(secrets.token_hex(32))'
POSTGRES_USER=clinical_user
POSTGRES_PASSWORD=replace-with-generated-hex-password
POSTGRES_DB=clinical_compass
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://clinical_user:replace-with-generated-hex-password@127.0.0.1:5432/clinical_compass
JWT_SECRET_KEY=replace-with-independent-generated-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=false
ALLOWED_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
# Optional existing RAG service; not required for the demonstration.
RAG_ENABLED=false
RAG_SERVICE_URL=http://127.0.0.1:8001/recommend
# Invitation emails. Local Docker captures emails in http://localhost:8025.
PUBLIC_APP_URL=http://localhost:5173
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=Clinical Compass <notifications@localhost>
# For real email: set your SMTP host, credentials, from address and starttls/ssl.
