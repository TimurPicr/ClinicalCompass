FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY alembic.ini ./
COPY app/backend ./app/backend
COPY app/database ./app/database
RUN useradd --create-home clinical
USER clinical
EXPOSE 8000
CMD ["sh", "-c", "python -m alembic upgrade head && python -m uvicorn app.backend.main:app --host 0.0.0.0 --port 8000 --no-access-log"]
