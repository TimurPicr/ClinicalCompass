000","alignment":"left"}},{"id":"sh/xcvaxk36","kind":"textbox","text":"Внимание","position":{"left":700,"top":246.13,"width":138.99,"height":25.01},"style":{"fontSize":18,"typeface":"Helvetica Neue","color":"#95671D","alignment":"left"}},{"id":"sh/a9kb25kf","kind":"textbox","text":"Основание доступно врачу","position":{"left":686,"top":298.13,"width":485.01,"height":49.01},"style":{"fontSize":31,"typeface":"Helvetica Neue","color":"#292D42","bold":true,"alignment":"left"}},{"id":"sh/kfmt8z2h","kind":"textbox","text":"Правила формируют сигнал до подготовки сводки","position":{"left":56,"top":130,"width":1168,"height":55},"style":{"fontSize":37,"typeface":"Helvetica Neue","color":"#FFFFFF","alignment":"left"}},{"id":"sh/5gvu1432","kind":"textbox","text":"Положительный ответ на критический\nпункт анкеты.\n\nСигнал формируется при сохранении\nответа.","position":{"left":86,"top":365.13,"width":529.98,"height":190},"style":{"fontSize":25,"typeface":"Helvetica Neue","color":"#758099","alignment":"left"}},{"id":"sh/f6h4ni9g","kind":"textbox","text":"Повышенные баллы анкеты\nПовторные явные пропуски приёма\nСообщения о нежелательных явлениях","position":{"left":686,"top":365.13,"width":482.02,"height":170},"style":{"fontSize":25,"typeface":"Helvetica Neue","color":"#758099","alignment":"left"}},{"id":"sh/el8ned8b","kind":"textbox","text":"Критический сигнал сохраняется до рассмотрения врачом.","position":{"left":60,"top":640,"width":1160,"height":70},"style":{"fontSize":29,"typeface":"Helvetica Neue","color":"#ADC5FF","alignment":"left"}}],"notes":{"text":"Красный детерминированный сигнал формируется при положительном ответе на пункт 9 анкеты депрессии. Он возникает при сохранении ответа и не зависит от генерации сводки. Приложение не имеет мгновенного клинического правила распознавания всех критических высказываний свободного текста дневника. Критический сигнал не снимается новой низкой оценкой или готовностью описания. Некритические сигналы могут разрешаться автоматически при исчезновении условия. Повторные явные пропуски лекарства и сообщения о нежелательных явлениях — отдельные основания внимания. Причинность нежелательного явления не доказана фактом сообщения.\n\nИсточники: docs/clinical-rules.md; app/backend/monitoring.py; tests/test_monitoring_scenarios.py"}}
{"id":"sl/m90b6t0r","index":9,"layout":{"id":"ly/ux4ruhcv","name":"BLANK"},"title":"Чат","elements":[{"id":"sh/srahs7e9","kind":"shape","position":{"left":40,"top":26,"width":1200,"height":66.02},"style":{"fontSize":18.67,"typeface":"Arial","color":"#000000","alignment":"left"}},{"id":"sh/jmh0vids","kind":"textbox","text":"Чат","position":{"left":112,"top":40,"width":835.84,"height":38.02},"style":{"fontSize":32.67,"typeface":"Helvetica Neue","color":"#292D42","bold":true,"alignment":"left"}},{"id":"im/j6pof69k","kind":"image","position":{"left":56,"top":37.01,"width":44,"height":44}},{"id":"sh/5ozixsvi","kind":"textbox","text":"10","position":{"left":1164,"top":38.99,"width":60,"height":38.02},"style":{"fontSize":32.67,"typeface":"Helvetica Neue","color":"#292D42","bold":true,"alignment":"center"}},{"id":"im/5876hgra","kind":"image","position":{"left":56,"top":202.48,"width":1168,"height":388}},{"id":"sh/3il07mdw","kind":"textbox","text":"Врач видит диалоги со своими пациентами в одном разделе","position":{"left":56,"top":130,"width":1168,"height":51},"style":{"fontSize":32,"typeface":"Helvetica Neue","color":"#FFFFFF","alignment":"left"}},{"id":"sh/2hsjyhwb","kind":"textbox","text":"Сообщения и вложения сохраняются в истории.","position":{"left":60,"top":637,"width":1160,"height":47},"style":{"fontSize":31,"typeface":"Helvetica Neue","color":"#ADC5FF","alignment":"left"}},{"id":"sh/a5s3mlsf","kind":"textbox","text":"Переписка доступна после восстановления связи.","position":{"left":60,"top":684,"width":1160,"height":25},"style":{"fontSize":20,"typeface":"Helvetica Neue","color":"#ADC5FF","alignment":"left"}}],"notes":{"text":"В кабинете врача есть общий список всех его диалогов. Сообщения и вложения сохраняются на сервере. Доставка использует постоянное соединение, повторное подключение и резервное обновление истории. История остаётся доступна после восстановления соединения. Изображение исходного шаблона сохранено. Переписка не обеспечивает экстренную помощь или гарантированный немедленный ответ врача.\n\nИсточники: app/backend/chat.py; app/frontend/src/pages/Messages.jsx; docs/chat-verification.md"}}
{"id":"sl/fii0ip","index":10,"layout":{"id":"ly/ux4ruhcv","name":"BLANK"},"title":"Функции и время обработки","elements":[{"id":"sh/yxwf65cj","kind":"shape","position":{"left":40,"top":26,"width":1200,"height":66.02},"style":{"fontSize":18.67,"typeface":"Arial","color":"#000000","alignment":"left"}},{"id":"sh/to7ylkv6","kind":"textbox","text":"Функции и время обработки","position":{"left":112,"top":38.99,"width":835.84,"height":38.02},"style":{"fontSize":32.67,"typeface":"Helvetica Neue","color":"#292D42","bold":true,"alignment":"left"}},{"id":"im/ih0fypo7","kind":"image","position":{"left":55,"top":37,"width":44,"height":44}},{"id":"sh/6lgfapcv","kind":"textbox","text":"11","position":{"left":1164,"top":38.99,"width":60,"height":38.02},"style":{"fontSize":32.67,"typeface":"Helvetica Neue","color":"#292D42","bold":true,"alignment":"center"}},{"id":"sh/ps3y90v2","kind":"textbox","text":"Результаты локального замера","position":{"left":56,"top":130,"width":1168,"height":57},"style":{"fontSize":39,"typeface":"Helvetica Neue","color":"#FFFFFF","alignment":"left"}},{"id":"sh/orux0veh","kind":"shape","position":{"left":56,"top":207,"width":1168,"height":373}},{"id":"tb/jexczy98","kind":"table","text":"Возможность\tПольза для врача\tМедиана\nКарта и назначения\tАнамнез и лечение в одной истории\t3,1 мс\nполучение карты\nДневник и анкеты\tДинамика состояния по датам\t3,4 мс\nполучение дневника\nПереписка\tИстория обсуждений с пациентом\t3,3 мс\nполучение истории\nКонтроль риска\tПравила и очередь описания\t6,0 мс\nоперация в базе*\nСводка состояния\tМатериал для разбора перед приёмом\t26,4 с\nпопытка создания**","position":{"left":66,"top":218,"width":1148,"height":334}},{"id":"sh/fy1cj6t0","kind":"textbox","text":"Apple M3 Pro, 18 ГБ. По 10 повторов быстрых операций без отрисовки, 3 попытки сводки.","position":{"left":60,"top":605,"width":1160,"height":29},"style":{"fontSize":19,"typeface":"Helvetica Neue","color":"#ADC5FF","alignment":"left"}},{"id":"sh/0zadcbal","kind":"textbox","text":"* Без окончательной фиксации в базе. ** Без очереди и наполненной базы источников.","position":{"left":60,"top":638,"width":1160,"height":29},"style":{"fontSize":19,"typeface":"Helvetica Neue","color":"#ADC5FF","alignment":"left"}},{"id":"sh/10julwbq","kind":"textbox","text":"Автоматические проверки содержания прошли 2 из 3 описаний. Врачебная оценка ещё впереди.","position":{"left":60,"top":671,"width":1160,"height":29},"style":{"fontSize":19,"typeface":"Helvetica Neue","color":"#ADC5FF","alignment":"left"}}],"notes":{"text":"Реальные локальные измерения 27.10.2026. Apple M3 Pro, 12 ядер, 18 GiB RAM, Ollama 0.40.11. Десять последовательных HTTP GET на каждую операцию с постоянным соединением, без авторизации и отрисовки. Обработка новой дневниковой записи: фактические insert/flush, производственные правила и очередь в PostgreSQL 16.15, без commit/HTTP. Временные изменения отменены. Три сценария модели: 25,807–27,005 с, медиана 26,400 с, включая модельную загрузку, контекст, создание, фиксацию/отмену в изолированной SQLite и автоматическую оценочную рубрику. Без очереди и наполненной базы источников. Все три ответа соответствовали схеме, два прошли автоматические проверки содержания. Один ответ добавил отсутствующую шкалу тревоги. Это не клиническая оценка точности, не нагрузочное испытание и не измерение экономии времени врача.\n\nИсточники: var/presentation/benchmark.json; scripts/benchmark_presentation.py"}}
